# Normalize line endings on checkin; LF for text files on checkout.
* text=auto eol=lf

# Windows-only formats: keep CRLF on checkout.
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf
*.sln       text eol=crlf
*.vcxproj   text eol=crlf
*.vcxproj.filters text eol=crlf
*.props     text eol=crlf
*.targets   text eol=crlf

# Binary blobs.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.bmp       binary
*.ico       binary
*.icns      binary
*.tga       binary
*.dds       binary
*.fbx       binary
*.dae       binary
*.obj       binary
